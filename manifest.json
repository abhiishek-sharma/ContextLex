{
  "manifest_version": 3,
  "name": "ContextLex",
  "version": "1.1.0",
  "description": "Double-click or select a word on a web page to see its definition in a tooltip. Definitions come from the Free Dictionary API.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
